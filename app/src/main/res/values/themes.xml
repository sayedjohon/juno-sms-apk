<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════
         Juno SMS — Premium Dark Theme
         Base: Deep Navy #0D1117 | Accent: Cyan #00D4FF
         ═══════════════════════════════════════════ -->
    <style name="Theme.SmsGateway" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryVariant">@color/bg_surface</item>
        <item name="colorOnPrimary">@color/bg_primary</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorSecondaryVariant">@color/accent_cyan_dim</item>
        <item name="colorOnSecondary">@color/bg_primary</item>

        <!-- Surfaces -->
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorBackground">@color/bg_primary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <!-- Card -->
        <item name="colorSurfaceVariant">@color/bg_card</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Status bar — deep navy, light icons -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/bg_primary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>

        <!-- Ripple -->
        <item name="rippleColor">@color/accent_cyan_alpha</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Card -->
        <item name="materialCardViewStyle">@style/JunoCardStyle</item>

        <!-- Bottom nav -->
        <item name="bottomNavigationStyle">@style/JunoBottomNav</item>

        <!-- Switch -->
        <item name="switchStyle">@style/JunoSwitch</item>
    </style>

    <!-- Card Style -->
    <style name="JunoCardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border_card</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="JunoBottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/bg_surface</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- Switch -->
    <style name="JunoSwitch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="colorControlActivated">@color/accent_cyan</item>
        <item name="thumbTint">@color/switch_thumb_color</item>
        <item name="trackTint">@color/switch_track_color</item>
    </style>

    <!-- Home screen card labels -->
    <style name="HomeCardLabel" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">start</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="HomeCardValue" parent="Widget.AppCompat.TextView">
        <item name="android:lines">1</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">start</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textColor">@color/text_link</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Status button — ONLINE -->
    <style name="StatusButtonOnline" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/status_online_bg</item>
        <item name="android:textColor">@color/status_online</item>
        <item name="strokeColor">@color/status_online</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Status button — OFFLINE -->
    <style name="StatusButtonOffline" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/status_offline_bg</item>
        <item name="android:textColor">@color/status_offline</item>
        <item name="strokeColor">@color/status_offline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>