<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    tools:context=".ui.HomeFragment">

    <!-- ── Connection Status Banner ── -->
    <TextView
        android:id="@+id/textConnectionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/rounded_background"
        android:backgroundTint="@color/connection_status_background"
        android:gravity="center"
        android:padding="10dp"
        android:textColor="@color/status_online"
        android:textSize="13sp"
        android:letterSpacing="0.04"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone"
        tools:text="● Internet connection: available"
        tools:visibility="visible" />

    <!-- ── Scrollable Content ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <!-- ── LOCAL SERVER CARD ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Icon badge -->
                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/icon_badge_bg"
                            android:backgroundTint="@color/icon_badge_bg">

                            <ImageView
                                android:id="@+id/imageLocalServer"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_local_server"
                                app:tint="@color/accent_green" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:id="@+id/headerLocalServer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_local_server"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Local Wi-Fi API server"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchUseLocalServer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Expanded details -->
                    <GridLayout
                        android:id="@+id/layoutLocalServer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:columnCount="2"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            style="@style/HomeCardLabel"
                            android:text="@string/local_address" />
                        <TextView
                            android:id="@+id/textLocalIP"
                            style="@style/HomeCardValue"
                            android:text="@string/dots"
                            tools:text="192.168.1.1:8080" />

                        <TextView
                            style="@style/HomeCardLabel"
                            android:text="@string/public_address" />
                        <TextView
                            android:id="@+id/textPublicIP"
                            style="@style/HomeCardValue"
                            android:text="@string/dots"
                            tools:text="203.0.113.0:8080" />

                        <TextView
                            style="@style/HomeCardLabel"
                            android:text="@string/label_username" />
                        <TextView
                            android:id="@+id/textLocalUsername"
                            style="@style/HomeCardValue"
                            tools:text="admin" />

                        <TextView
                            style="@style/HomeCardLabel"
                            android:text="@string/label_password" />
                        <TextView
                            android:id="@+id/textLocalPassword"
                            style="@style/HomeCardValue"
                            tools:text="••••••••" />

                        <TextView
                            style="@style/HomeCardLabel"
                            android:text="@string/device_id" />
                        <TextView
                            android:id="@+id/textLocalDeviceId"
                            style="@style/HomeCardValue"
                            tools:text="juno-device-001" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonCopyAllLocal"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_columnSpan="2"
                            android:layout_gravity="fill_horizontal"
                            android:layout_marginTop="12dp"
                            android:text="@string/copy_all_credentials"
                            android:textColor="@color/accent_green"
                            app:icon="@drawable/ic_copy"
                            app:iconTint="@color/accent_green" />
                    </GridLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── CLOUD SERVER CARD ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Icon badge -->
                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/icon_badge_bg"
                            android:backgroundTint="@color/icon_badge_bg">

                            <ImageView
                                android:id="@+id/imageRemoteServer"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_cloud_server"
                                app:tint="@color/accent_green" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:id="@+id/headerRemoteServer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cloud_server"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_address_is_sms_capcom_me"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchUseRemoteServer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Expanded details -->
                    <GridLayout
                        android:id="@+id/layoutRemoteServer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:columnCount="2"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            style="@style/HomeCardLabel"
                            android:text="@string/server_address" />
                        <TextView
                            android:id="@+id/textRemoteAddress"
                            style="@style/HomeCardValue"
                            android:autoLink="web"
                            android:text="@string/dots"
                            tools:text="@string/settings_address_is_sms_capcom_me" />

                        <TextView
                            style="@style/HomeCardLabel"
                            android:text="@string/label_username" />
                        <TextView
                            android:id="@+id/textRemoteUsername"
                            style="@style/HomeCardValue"
                            tools:text="HXEHC2" />

                        <TextView
                            style="@style/HomeCardLabel"
                            android:text="@string/label_password" />
                        <TextView
                            android:id="@+id/textRemotePassword"
                            style="@style/HomeCardValue"
                            tools:text="••••••••" />

                        <TextView
                            style="@style/HomeCardLabel"
                            android:text="@string/device_id" />
                        <TextView
                            android:id="@+id/textRemoteDeviceId"
                            style="@style/HomeCardValue"
                            tools:text="juno-cloud-001" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonCopyAllRemote"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_columnSpan="2"
                            android:layout_gravity="fill_horizontal"
                            android:layout_marginTop="12dp"
                            android:text="@string/copy_all_credentials"
                            android:textColor="@color/accent_green"
                            app:icon="@drawable/ic_copy"
                            app:iconTint="@color/accent_green" />
                    </GridLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- ── Bottom Controls ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_surface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- Start on boot row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_start_on_boot"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAutostart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Start / Stop Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonStart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:textSize="15sp"
            android:letterSpacing="0.08"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="true"
            android:checkable="true"
            app:backgroundTint="@color/accent_green_pale"
            android:textColor="@color/accent_green"
            app:strokeColor="@color/accent_green"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp"
            android:text="@string/settings_offline"
            tools:text="OFFLINE" />
    </LinearLayout>

</androidx.appcompat.widget.LinearLayoutCompat>